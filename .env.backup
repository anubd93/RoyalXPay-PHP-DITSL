--------------------------------------------------------------------
Example Environment Configuration file

This file can be used as a starting point for your own
custom .env files, and contains most of the possible settings
available in a default install.

By default, all of the settings are commented out. If you want
to override the setting, you must un-comment it by removing the '#'
at the beginning of the line.
--------------------------------------------------------------------

--------------------------------------------------------------------
ENVIRONMENT
--------------------------------------------------------------------

CI_ENVIRONMENT=development

--------------------------------------------------------------------
APP
--------------------------------------------------------------------

APP_BASE_URL = 'http://localhost:8080/'
If you have trouble with `.`, you could also use `_`.
app_baseURL = ''
APP_FORCE_GLOBAL_SECURE_REQUESTS = false
APP_CSP_ENABLED = false
app.debug = true

--------------------------------------------------------------------
DATABASE
--------------------------------------------------------------------

DB_HOSTNAME = 127.0.0.1
DB_NAME = royalxpay
DB_USERNAME = root
DB_PASSWORD = 
DB_DRIVER = MySQLi
DB_PREFIX =
DB_PORT = 3306

If you use MySQLi as tests, first update the values of Config\Database::$tests.
database.tests.hostname = 127.0.0.1
database.tests.database = ci4_test
database.tests.username = root
database.tests.password = root
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

--------------------------------------------------------------------
ENCRYPTION
--------------------------------------------------------------------

ENCRYPTION_KEY =

--------------------------------------------------------------------
SESSION
--------------------------------------------------------------------

SESSION_DRIVER = 'CodeIgniter\Session\Handlers\FileHandler'
SESSION_SAVE_PATH = null

--------------------------------------------------------------------
LOGGER
--------------------------------------------------------------------

LOGGER_THRESHOLD = 4


# APP_BASE_URL = 'http://stg-gw.tadlbd.com:885/'
API_KEY = 

--------------------------------------------------------------------
TAP PAYMENT WEBHOOK
--------------------------------------------------------------------

# TAP Webhook Secret for HMAC signature verification
TAP_WEBHOOK_SECRET = 

--------------------------------------------------------------------
TAP REMITTANCE API (External API hosted by TAP)
--------------------------------------------------------------------

# TAP Remittance API Base URL
# Note: Only used when CI_ENVIRONMENT is NOT 'local'
# TAP_REMITTANCE_BASE_URL = http://stg-gw.tadlbd.com:885/Remittance

# TAP Remittance API Key (used in X-API-KEY header)
TAP_REMITTANCE_API_KEY = 

# Note: TAP uses API Key only. No username/password required.


TAP_REMITTANCE_BASE_URL = 
TAB_REMITTENCE_URL = 